{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tickervector.example/schemas/company-research.schema.json",
  "title": "Ticker Vector cited company research snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "company_key",
    "generated_at",
    "source_document_count",
    "validated_evidence_count",
    "research",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "company_key": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_document_count": { "type": "integer", "minimum": 0 },
    "validated_evidence_count": { "type": "integer", "minimum": 0 },
    "research": {
      "type": "object",
      "required": ["overview", "positives", "risks", "management_guidance", "key_deliverables", "walk_the_talk"],
      "properties": {
        "overview": {
          "type": "object",
          "required": ["sections"],
          "properties": {
            "sections": {
              "type": "array",
              "items": { "$ref": "#/$defs/citedSection" }
            }
          }
        },
        "positives": { "type": "array", "items": { "$ref": "#/$defs/citedPoint" } },
        "risks": { "type": "array", "items": { "$ref": "#/$defs/citedPoint" } },
        "management_guidance": { "type": "array", "items": { "$ref": "#/$defs/guidance" } },
        "key_deliverables": { "type": "array", "items": { "$ref": "#/$defs/deliverable" } },
        "walk_the_talk": { "type": "array", "items": { "$ref": "#/$defs/walkTheTalk" } }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    }
  },
  "$defs": {
    "documentIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^ff-[a-f0-9]{24}$" }
    },
    "citedSection": {
      "type": "object",
      "required": ["heading", "text", "document_ids"],
      "properties": {
        "heading": { "type": "string" },
        "text": { "type": "string" },
        "document_ids": { "$ref": "#/$defs/documentIds" }
      }
    },
    "citedPoint": {
      "type": "object",
      "required": ["point", "why_it_matters", "document_ids"],
      "properties": {
        "point": { "type": "string" },
        "why_it_matters": { "type": "string" },
        "document_ids": { "$ref": "#/$defs/documentIds" }
      }
    },
    "guidance": {
      "type": "object",
      "required": ["guidance_id", "statement", "document_ids"],
      "properties": {
        "guidance_id": { "type": "string" },
        "statement": { "type": "string" },
        "metric": {},
        "target": {},
        "target_period": {},
        "document_ids": { "$ref": "#/$defs/documentIds" }
      }
    },
    "deliverable": {
      "type": "object",
      "required": ["deliverable", "metric_or_milestone", "status", "document_ids"],
      "properties": {
        "deliverable": { "type": "string" },
        "metric_or_milestone": { "type": "string" },
        "due_period": {},
        "status": { "enum": ["pending", "achieved", "partially_achieved", "missed", "unverifiable"] },
        "document_ids": { "$ref": "#/$defs/documentIds" }
      }
    },
    "walkTheTalk": {
      "type": "object",
      "required": ["guidance_id", "status", "assessment", "guidance_document_ids", "outcome_document_ids"],
      "properties": {
        "guidance_id": { "type": "string" },
        "status": { "enum": ["achieved", "partially_achieved", "missed", "pending", "unverifiable"] },
        "assessment": { "type": "string" },
        "guidance_document_ids": { "$ref": "#/$defs/documentIds" },
        "outcome_document_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^ff-[a-f0-9]{24}$" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["claim_type", "statement", "citation"],
      "properties": {
        "claim_type": { "enum": ["business_fact", "positive", "risk", "guidance", "outcome"] },
        "statement": { "type": "string" },
        "citation": {
          "type": "object",
          "required": ["document_id", "content_sha256", "quote"],
          "properties": {
            "document_id": { "type": "string", "pattern": "^ff-[a-f0-9]{24}$" },
            "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "source_pdf": { "type": ["string", "null"] },
            "filing_date": { "type": ["string", "null"] },
            "title": { "type": "string" },
            "heading": { "type": ["string", "null"] },
            "quote": { "type": "string", "minLength": 12 }
          }
        }
      }
    }
  }
}
